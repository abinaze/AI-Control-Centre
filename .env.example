# AI Control Centre environment variables.
#
# AIC does NOT load .env files automatically. Export these in your shell
# (for example from your Git Bash profile), or set them for a single command.
# Every line below is commented out, so copying this file changes nothing.

# Directory holding projects.json, goals.json, and tasks.json.
# Default on Windows: %LOCALAPPDATA%\AI-Control-Centre
# Default elsewhere:  ~/.local/share/ai-control-centre
# AIC_DATA_DIR=

# Reserved for future use. It is read into configuration but no component
# uses it yet.
# AIC_DEFAULT_MODEL_PROVIDER=local
